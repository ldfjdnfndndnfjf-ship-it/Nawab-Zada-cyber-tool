body { background: #000; color: #0f0; font-family: 'Courier New', monospace; margin: 0; padding: 10px; }

/* Matrix Background Effect */
canvas { position: fixed; top: 0; left: 0; z-index: -1; }

.header { text-align: center; border-bottom: 2px solid #0f0; margin-bottom: 15px; }

.input-area input { width: 95% !important; border: 2px solid #0f0; font-size: 16px; }

.btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }

button { padding: 20px; font-weight: bold; border: 2px solid; cursor: pointer; text-transform: uppercase; }

.terminal { background: rgba(0, 20, 0, 0.9); height: 250px; margin-top: 20px; padding: 15px; border: 2px solid #0f0; overflow-y: scroll; font-size: 14px; }
