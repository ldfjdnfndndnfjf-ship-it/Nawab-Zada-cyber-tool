body { background: #000; color: #0f0; font-family: monospace; }
.header { text-align: center; border-bottom: 1px solid #0f0; padding: 10px; }
.btn-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 20px; }
button { background: #000; color: #0f0; border: 1px solid #0f0; padding: 15px; cursor: pointer; }
button:hover { background: #0f0; color: #000; }
.terminal { background: #111; height: 300px; margin: 20px; padding: 10px; border: 1px solid #0f0; overflow-y: scroll; }
